{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Api": {
    "BaseUrl": "http://localhost:8888/"
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 20,
      "WindowMinutes": 5
    },
    "VerifyEmail": {
      "PermitLimit": 20,
      "WindowMinutes": 5
    },
    "ResendVerification": {
      "PermitLimit": 10,
      "WindowMinutes": 5
    }
  }
}
