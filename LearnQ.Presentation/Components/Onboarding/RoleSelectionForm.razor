@using LearnQ.Application.Common.Enums

<PageHeader Title="Choose Your Role" Subtitle="Select how you would like to use LearnQ." />

<EditForm Model="Model" FormName="role-selection" OnValidSubmit="HandleValidSubmit" Enhance novalidate>
    <DataAnnotationsValidator />

    @if (!string.IsNullOrWhiteSpace(DisplayErrorMessage))
    {
        <div class="alert alert-danger py-2 small" role="alert">@DisplayErrorMessage</div>
    }

    <InputRadioGroup @bind-Value="Model.Role">
        <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
                <InputRadio Value="@UserRole.Student" class="btn-check" id="role-student" />
                <label class="btn btn-outline-primary w-100 p-3 text-center" for="role-student">
                    <h6 class="fw-semibold mb-1">Student</h6>
                    <p class="small mb-0">Learn for yourself or find qualified teachers for your family.</p>
                </label>
            </div>

            <div class="col-12 col-md-6">
                <InputRadio Value="@UserRole.Teacher" class="btn-check" id="role-teacher" />
                <label class="btn btn-outline-primary w-100 p-3 text-center" for="role-teacher">
                    <h6 class="fw-semibold mb-1">Teacher</h6>
                    <p class="small mb-0">Apply as an instructor, manage availability, and teach learners.</p>
                </label>
            </div>
        </div>
    </InputRadioGroup>

    <div class="mb-3 text-center">
        <ValidationMessage For="@(() => Model.Role)" class="invalid-feedback d-block" />
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-primary w-100" disabled="@IsSubmitting">
            Continue
        </button>
    </div>
</EditForm>

<p class="text-center text-body-secondary small mt-3 mb-0">
    <a href="@AppRoutes.Home">Back to home</a>
</p>

@code {
    [SupplyParameterFromForm]
    public RoleSelectionInput Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<RoleSelectionInput> OnSubmit { get; set; }

    [Parameter]
    public ApiError? Error { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    private string? DisplayErrorMessage => ErrorMessage ?? Error?.Message;

    protected override void OnInitialized()
    {
        Model ??= new();
    }

    private Task HandleValidSubmit() => OnSubmit.InvokeAsync(Model);
}
