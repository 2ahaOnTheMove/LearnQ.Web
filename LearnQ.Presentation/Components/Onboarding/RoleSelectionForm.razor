@using LearnQ.Application.Common.Enums

<EditForm Model="Model" FormName="role-selection" OnValidSubmit="HandleValidSubmit" Enhance novalidate>
    <DataAnnotationsValidator />

    <div class="text-center mb-4">
        <h2 class="h3 fw-bold mb-2">Choose your role</h2>
        <p class="text-muted">Select how you would like to use LearnQ to get started.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(DisplayErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@DisplayErrorMessage</div>
    }

    <InputRadioGroup @bind-Value="Model.Role">
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6">
                <InputRadio Value="@UserRole.Student" class="btn-check" id="role-student" />
                <label class="btn btn-outline-primary w-100 h-100 p-3 text-center" for="role-student">
                    <div class="fs-1 mb-2">🎓</div>
                    <h5 class="card-title fw-bold mb-1">Student</h5>
                    <p class="card-text small mb-0">Learn for yourself or find qualified teachers for your family.</p>
                </label>
            </div>

            <div class="col-12 col-md-6">
                <InputRadio Value="@UserRole.Teacher" class="btn-check" id="role-teacher" />
                <label class="btn btn-outline-primary w-100 h-100 p-3 text-center" for="role-teacher">
                    <div class="fs-1 mb-2">👩‍🏫</div>
                    <h5 class="card-title fw-bold mb-1">Teacher</h5>
                    <p class="card-text small mb-0">Apply as an instructor, manage availability, and teach learners.</p>
                </label>
            </div>
        </div>
    </InputRadioGroup>

    <div class="mb-3 text-center">
        <ValidationMessage For="@(() => Model.Role)" class="invalid-feedback d-block" />
    </div>

    <div class="d-grid gap-2">
        <button type="submit" class="btn btn-primary btn-lg" disabled="@IsSubmitting">
            <span>Continue</span>
        </button>
        <a href="@AppRoutes.Home" class="btn btn-link text-decoration-none text-muted">Back to home</a>
    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    public RoleSelectionInput Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<RoleSelectionInput> OnSubmit { get; set; }

    [Parameter]
    public ApiError? Error { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public bool IsSubmitting { get; set; }

    private string? DisplayErrorMessage => ErrorMessage ?? Error?.Message;

    protected override void OnInitialized()
    {
        Model ??= new();
    }

    private Task HandleValidSubmit() => OnSubmit.InvokeAsync(Model);
}
