@attribute [Route(AppRoutes.NotFound)]
@attribute [AllowAnonymous]

<XPageTitle Name="Not Found" />

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        if (HttpContext is not null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }
}

<NoticeModal Title="Page Not Found"
             Message="Sorry, the page you are looking for does not exist or may have been moved."
             CloseHref="@AppRoutes.Home"
             CloseText="Go to Home">
    <AdditionalButtons>
        <a href="@AppRoutes.Dashboard" class="btn btn-outline-secondary me-2">Go to Dashboard</a>
    </AdditionalButtons>
</NoticeModal>
