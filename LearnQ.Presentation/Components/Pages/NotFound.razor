@using LearnQ.Presentation.Notices
@attribute [Route(AppRoutes.NotFound)]
@attribute [AllowAnonymous]
@inject IHttpContextAccessor HttpContextAccessor

<XPageTitle Name="Not Found" />

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized()
    {
        var context = HttpContext ?? HttpContextAccessor.HttpContext;
        if (context is not null && !context.Response.HasStarted)
        {
            context.Response.StatusCode = StatusCodes.Status404NotFound;
        }
    }

    private static readonly NoticeCatalog.NoticeEntry Entry = NoticeCatalog.NoticeEntry.NotFound;
}

<NoticeModal Title="@Entry.Title"
             Message="@Entry.Message"
             CloseHref="@AppRoutes.Home"
             CloseText="@Entry.CloseText"
             Severity="@Entry.Severity">
    <AdditionalButtons>
        <a href="@AppRoutes.Dashboard" class="btn btn-outline-secondary btn-sm">Dashboard</a>
    </AdditionalButtons>
</NoticeModal>
