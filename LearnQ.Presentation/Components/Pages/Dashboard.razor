@attribute [Route(AppRoutes.Dashboard)]
@attribute [Authorize(Policy = AuthPolicies.OnboardingCompleted)]

<XPageTitle Name="Dashboard" />

<PageHeader Title="Dashboard" Subtitle="Welcome to LearnQ. Your onboarding is complete." />

<div class="card border">
    <div class="card-body p-3 p-md-4">
        <h6 class="fw-semibold mb-2">Explore Teachers</h6>
        <p class="text-body-secondary small mb-3">Find qualified Quran and Arabic teachers for personalized one-on-one lessons.</p>
        <a href="@AppRoutes.Home" class="btn btn-primary">Browse Teachers</a>
    </div>
</div>
