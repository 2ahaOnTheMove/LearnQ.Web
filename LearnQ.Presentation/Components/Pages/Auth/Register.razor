@attribute [Route(AppRoutes.Register)]
@inject IClientApi Api
@inject NavigationManager Navigation

<XPageTitle Name="Sign Up" />
<RegisterForm OnSubmit="HandleRegister" ErrorMessage="@_errorMessage" />

@code {
    private string? _errorMessage;

    private async Task HandleRegister(RegisterInput input)
    {
        _errorMessage = null;

        var request = new RegisterClientRequest(
            input.GivenName,
            input.FamilyName,
            input.DisplayName,
            input.Email,
            input.Password,
            input.TermsAccepted,
            input.PrivacyAccepted);

        var result = await Api.RegisterAsync(request);

        if (!result.IsSuccess)
        {
            _errorMessage = result.Error;
            return;
        }

        Navigation.NavigateTo(AppRoutes.Onboarding);
    }
}
