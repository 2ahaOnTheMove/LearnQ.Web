@attribute [Route(AppRoutes.Onboarding)]
@inject IOnboardingApi OnboardingApi
@inject NavigationManager Navigation

<XPageTitle Name="Onboarding" />

<div class="text-center py-5">
    <div class="spinner-border text-primary mb-3" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <p class="text-muted">Loading your onboarding status...</p>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var result = await OnboardingApi.GetStatusAsync();
        var destination = result.IsSuccess && result.Value is not null
            ? OnboardingRoute.GetDestination(result.Value)
            : AppRoutes.OnboardingRole;

        Navigation.NavigateTo(destination);
    }
}
