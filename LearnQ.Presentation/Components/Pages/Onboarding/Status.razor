@attribute [Route(AppRoutes.OnboardingStatus)]
@attribute [Authorize(Policy = AuthPolicies.OnboardingCompleted)]

<XPageTitle Name="Onboarding Complete" />

<PageHeader Title="Almost Done!" Subtitle="Your profile has been submitted successfully. Our team will review your details shortly." />

<div class="text-center py-4 py-md-5">
    <div class="mb-4">
        <div style="width: 72px; height: 72px; margin: 0 auto; border-radius: 50%; background: var(--bs-primary-bg-subtle); color: var(--bs-primary); display: inline-flex; align-items: center; justify-content: center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6L9 17l-5-5" />
            </svg>
        </div>
    </div>

    <div class="alert alert-primary-subtle border border-primary-subtle py-3 mb-4">
        <p class="mb-0 text-body-secondary">You'll receive an email once your profile has been reviewed. You can explore the platform in the meantime.</p>
    </div>

    <div class="d-flex flex-column gap-2 align-items-center">
        <a href="@AppRoutes.Dashboard" class="btn btn-primary">Go to Dashboard</a>
        <a href="@AppRoutes.Home" class="btn btn-link text-decoration-none text-body-secondary small">Return to Home</a>
    </div>
</div>
