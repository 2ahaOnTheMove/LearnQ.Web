@attribute [Route(AppRoutes.OnboardingStatus)]

<XPageTitle Name="Profile Under Review" />

<div class="text-center py-4">
    <div class="display-1 text-primary mb-3">⏳</div>
    <h2 class="h3 fw-bold mb-3">Your Profile is Under Review</h2>
    <p class="text-muted lead mb-4">
        Thank you for submitting your teacher profile! Our team is currently reviewing your details and credentials.
    </p>
    <p class="text-secondary small mb-4">
        You will receive an update once your profile has been approved and published.
    </p>
    <div>
        <a href="@AppRoutes.Home" class="btn btn-outline-primary px-4">Return to Home</a>
    </div>
</div>
