@attribute [Route(AppRoutes.OnboardingStatus)]
@attribute [Authorize(Policy = AuthPolicies.TeacherOnly)]

<XPageTitle Name="Profile Under Review" />

<PageHeader Title="Profile Under Review" Subtitle="Thank you for submitting your teacher profile. Our team is currently reviewing your details and credentials." />

<div class="text-center py-4 py-md-5">
    <div class="alert alert-primary-subtle border border-primary-subtle py-3">
        <p class="mb-0 text-body-secondary">You will receive an update once your profile has been approved and published.</p>
    </div>
    <div class="mt-3">
        <a href="@AppRoutes.Home" class="btn btn-outline-primary">Return to Home</a>
    </div>
</div>
