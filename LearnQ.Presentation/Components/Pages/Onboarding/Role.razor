@attribute [Route(AppRoutes.OnboardingRole)]
@inject IOnboardingApi OnboardingApi
@inject IAuthService AuthService
@inject NavigationManager Navigation

<XPageTitle Name="Choose Role" />

<RoleSelectionForm OnSubmit="HandleRoleSelection"
                   Error="@_apiError"
                   IsSubmitting="@_isSubmitting" />

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private ApiError? _apiError;
    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        if (OnboardingRoute.ShouldSkipGuard(HttpContext))
        {
            return;
        }

        var statusResult = await OnboardingApi.GetStatusAsync();
        if (statusResult.IsSuccess && statusResult.Value is not null)
        {
            var redirect = OnboardingRoute.GetGuardRedirect(statusResult.Value, AppRoutes.OnboardingRole);
            if (redirect is not null)
            {
                Navigation.NavigateTo(redirect);
            }
        }
    }

    private async Task HandleRoleSelection(RoleSelectionInput input)
    {
        if (input.Role is null)
        {
            _apiError = new ApiError(null, "Please choose a role to continue.", 0);
            return;
        }

        _apiError = null;
        _isSubmitting = true;

        var request = new SelectRoleRequest(input.Role.Value);
        var result = await OnboardingApi.SelectRoleAsync(request);

        _isSubmitting = false;

        if (result.IsFailure)
        {
            _apiError = result.Error;
            return;
        }

        if (HttpContext is not null)
        {
            await AuthService.RefreshPrincipalAsync(HttpContext);
        }

        var destination = input.Role.Value == UserRole.Student
            ? AppRoutes.OnboardingStudent
            : AppRoutes.OnboardingTeacher;

        Navigation.NavigateTo(destination);
    }
}
