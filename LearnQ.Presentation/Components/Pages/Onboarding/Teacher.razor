@using static Microsoft.AspNetCore.Components.Web.RenderMode
@attribute [Route(AppRoutes.OnboardingTeacher)]
@attribute [Authorize(Policy = AuthPolicies.TeacherOnly)]
@rendermode InteractiveServer
@inject IOnboardingApi OnboardingApi
@inject IAuthService AuthService
@inject NavigationManager Navigation

<XPageTitle Name="Teacher Profile" />

<TeacherOnboardingForm OnSubmit="HandleTeacherSubmit"
                       Error="@_apiError"
                       IsSubmitting="@_isSubmitting" />

@code {
    private ApiError? _apiError;
    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        var statusResult = await OnboardingApi.GetStatusAsync();
        if (statusResult.IsSuccess && statusResult.Value is not null)
        {
            var redirect = OnboardingRoute.GetGuardRedirect(statusResult.Value, AppRoutes.OnboardingTeacher);
            if (redirect is not null)
            {
                Navigation.NavigateTo(redirect, forceLoad: true);
            }
        }
    }

    private async Task HandleTeacherSubmit(TeacherOnboardingInput input)
    {
        _apiError = null;
        _isSubmitting = true;

        var request = new TeacherOnboardingRequest(
            input.AvatarUrl,
            input.Headline,
            input.Bio,
            input.IntroVideoUrl,
            input.Gender,
            input.YearsExperience ?? 0,
            input.Language,
            input.TeachesKids,
            input.TeachesTeens,
            input.TeachesAdults,
            input.GenderRestriction,
            input.MaxWeeklyHours ?? 20
        );

        var result = await OnboardingApi.SubmitTeacherAsync(request);
        _isSubmitting = false;

        if (result.IsFailure)
        {
            _apiError = result.Error;
            return;
        }

        // RefreshPrincipalAsync uses IHttpContextAccessor fallback, no HttpContext needed
        await AuthService.RefreshPrincipalAsync();
        Navigation.NavigateTo(AppRoutes.OnboardingStatus, forceLoad: true);
    }
}
