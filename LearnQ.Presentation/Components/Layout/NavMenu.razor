@using LearnQ.Presentation.Routing
@using LearnQ.Presentation.Security

<header class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
    <div class="container">
        <a class="navbar-brand fw-bold text-primary" href="@AppRoutes.Home">LearnQ</a>
        <div class="collapse navbar-collapse show" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <NavLink class="nav-link" href="@AppRoutes.Home" Match="NavLinkMatch.All">Home</NavLink>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto align-items-center">
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item me-3">
                            <span class="navbar-text fw-semibold text-secondary">
                                👋 @context.User.Identity?.Name
                            </span>
                        </li>
                        <li class="nav-item me-2">
                            <NavLink class="nav-link" href="@AppRoutes.Dashboard">Dashboard</NavLink>
                        </li>
                        <li class="nav-item">
                            <form method="post" action="@AppRoutes.Logout" class="d-inline">
                                <AntiforgeryToken />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Sign Out</button>
                            </form>
                        </li>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item me-2">
                            <NavLink class="nav-link" href="@AppRoutes.Login">Sign In</NavLink>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm" href="@AppRoutes.Register">Register</a>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </div>
</header>
