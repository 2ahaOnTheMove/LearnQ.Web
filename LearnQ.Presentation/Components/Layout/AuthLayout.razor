@inherits LayoutComponentBase

<NoticeHost />
<main class="bg-light min-vh-100 d-flex align-items-center justify-content-center py-4 py-md-5">
    <div class="w-100 px-3 auth-card @(Wide ? "auth-card--wide" : "")">
        <div class="text-center mb-3 mb-md-4">
            <BrandLogo Variant="BrandLogoVariant.Full" Height="32" Link="true" />
        </div>
        <div class="card border shadow-sm">
            <div class="card-body p-3 p-md-4">
                @Body
            </div>
        </div>
    </div>
</main>

@code {
    [Parameter] public bool Wide { get; set; }
}