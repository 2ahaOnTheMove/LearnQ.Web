<PageHeader Title="Create Account" Subtitle="Join LearnQ to start the journey" />

<EditForm EditContext="_editContext" FormName="register" OnValidSubmit="HandleValidSubmit" Enhance novalidate>
    <DataAnnotationsValidator />
    <BootstrapValidation />

    @if (!string.IsNullOrWhiteSpace(DisplayErrorMessage))
    {
        <div class="alert alert-danger py-2 small" role="alert">@DisplayErrorMessage</div>
    }

    <div class="row g-3">
        <FormField Class="col-md-6" Label="First name" For="() => Model.GivenName">
            <InputText id="GivenName" @bind-Value="Model.GivenName" autocomplete="given-name" class="form-control" />
        </FormField>

        <FormField Class="col-md-6" Label="Last name" For="() => Model.FamilyName">
            <InputText id="FamilyName" @bind-Value="Model.FamilyName" autocomplete="family-name" class="form-control" />
        </FormField>
    </div>

    <FormField Label="Display name" For="() => Model.DisplayName">
        <InputText id="DisplayName" @bind-Value="Model.DisplayName" autocomplete="username" class="form-control" />
    </FormField>

    <FormField Label="Email" For="() => Model.Email">
        <InputText id="Email" type="email" @bind-Value="Model.Email" autocomplete="email" class="form-control" />
    </FormField>

    <div class="row g-3">
        <FormField Class="col-md-6" Label="Password" For="() => Model.Password">
            <InputText id="Password" type="password" @bind-Value="Model.Password" autocomplete="new-password" class="form-control" />
        </FormField>

        <FormField Class="col-md-6" Label="Confirm password" For="() => Model.ConfirmPassword">
            <InputText id="ConfirmPassword" type="password" @bind-Value="Model.ConfirmPassword" autocomplete="new-password" class="form-control" />
        </FormField>
    </div>

    <FormField Label="Referral code (optional)" For="() => Model.ReferralCode">
        <InputText id="ReferralCode" @bind-Value="Model.ReferralCode" autocomplete="off" class="form-control" />
    </FormField>

    <FormCheck For="() => Model.TermsAccepted">
        <Label>I have read and agree to the <a href="@AppRoutes.Terms" target="_blank">Terms and Conditions</a></Label>
        <ChildContent>
            <InputCheckbox id="TermsAccepted" class="form-check-input" @bind-Value="Model.TermsAccepted" />
        </ChildContent>
    </FormCheck>

    <FormCheck For="() => Model.PrivacyAccepted">
        <Label>I have read and agree to the <a href="@AppRoutes.Privacy" target="_blank">Privacy Policy</a></Label>
        <ChildContent>
            <InputCheckbox id="PrivacyAccepted" class="form-check-input" @bind-Value="Model.PrivacyAccepted" />
        </ChildContent>
    </FormCheck>

    <div class="d-grid mt-3">
        <button class="btn btn-primary w-100" type="submit">Create Account</button>
    </div>
</EditForm>

<p class="text-center text-body-secondary small mt-3 mb-0">
    Already have an account? <a href="@AppRoutes.Login">Sign in</a>
</p>

@code {
    private EditContext _editContext = default!;
    private ValidationMessageStore _messageStore = default!;
    private RegisterInput? _previousModel;

    [SupplyParameterFromForm]
    public RegisterInput Model { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<RegisterInput> OnSubmit { get; set; }

    [Parameter]
    public ApiError? Error { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, string[]>? FieldErrors { get; set; }

    private string? DisplayErrorMessage => ErrorMessage ?? Error?.Message;
    private IReadOnlyDictionary<string, string[]>? EffectiveFieldErrors => FieldErrors ?? Error?.FieldErrors;

    protected override void OnInitialized()
    {
        Model ??= new();
        EnsureEditContext();
    }

    protected override void OnParametersSet()
    {
        Model ??= new();
        EnsureEditContext();

        ApplyServerErrors();
    }

    private void EnsureEditContext()
    {
        if (_editContext is null || !ReferenceEquals(Model, _previousModel))
        {
            _previousModel = Model;
            _editContext = new EditContext(Model);
            _messageStore = new ValidationMessageStore(_editContext);

            _editContext.OnFieldChanged += (sender, args) =>
            {
                _messageStore.Clear(args.FieldIdentifier);
                _editContext.NotifyValidationStateChanged();
            };

            _editContext.OnValidationRequested += (sender, args) =>
            {
                _messageStore.Clear();
            };
        }
    }

    public void ApplyServerErrors()
    {
        var errors = EffectiveFieldErrors;
        if (errors is { Count: > 0 } && _messageStore is not null && _editContext is not null)
        {
            _messageStore.Clear();
            _messageStore.AddFieldErrors(Model, errors);
            _editContext.NotifyValidationStateChanged();
        }
    }

    private Task HandleValidSubmit() => OnSubmit.InvokeAsync(Model);
}
