@using LearnQ.Application.Common.Models
@using LearnQ.Presentation.Routing

<div class="text-center mb-4">
    <div class="fs-1 mb-2">✉️</div>
    <h2 class="fw-bold">Verify Your Email</h2>
    <p class="text-muted">Enter the 6-digit confirmation code sent to your email address.</p>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @ErrorMessage
    </div>
}

@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <div class="alert alert-success" role="alert">
        @SuccessMessage
    </div>
}

<EditForm Model="Model"
          FormName="verify-email-form"
          OnValidSubmit="HandleValidSubmit"
          Enhance
          novalidate>
    <DataAnnotationsValidator />

    <div class="mb-4 text-center">
        <label for="verificationCode" class="form-label fw-semibold">6-Digit Verification Code</label>
        <InputText id="verificationCode"
                   class="form-control form-control-lg text-center fw-bold fs-3 letter-spacing-2"
                   style="letter-spacing: 0.5em; max-width: 280px; margin: 0 auto;"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   pattern="\d{6}"
                   maxlength="6"
                   placeholder="123456"
                   @bind-Value="Model.Code" />
        <ValidationMessage For="() => Model.Code" class="invalid-feedback d-block" />
    </div>

    <div class="d-grid gap-2 mb-3">
        <button type="submit" class="btn btn-primary btn-lg" disabled="@IsSubmitting">
            <span>Verify Email</span>
        </button>
    </div>
</EditForm>

<div class="d-flex flex-column align-items-center gap-2 mt-4 pt-3 border-top">
    @if (ResendCooldownSeconds > 0)
    {
        <p class="text-muted small mb-0">
            You can request a new code in @ResendCooldownSeconds seconds.
        </p>
    }
    else
    {
        <form method="post" action="@AppRoutes.VerifyEmail?action=resend" class="d-inline">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-link text-decoration-none p-0" disabled="@IsSubmitting">
                Resend verification code
            </button>
        </form>
    }

    <form method="post" action="@AppRoutes.Logout" class="d-inline mt-2">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-link text-decoration-none text-muted small p-0">
            Log out and verify later
        </button>
    </form>
</div>

@code {
    [Parameter, EditorRequired] public EventCallback<VerifyEmailInput> OnSubmit { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public int ResendCooldownSeconds { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }

    [SupplyParameterFromForm]
    public VerifyEmailInput Model { get; set; } = default!;

    protected override void OnInitialized()
    {
        Model ??= new();
    }

    protected override void OnParametersSet()
    {
        Model ??= new();
    }

    private async Task HandleValidSubmit()
    {
        await OnSubmit.InvokeAsync(Model);
    }
}
