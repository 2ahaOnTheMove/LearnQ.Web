@using LearnQ.Application.Common.Models
@using LearnQ.Presentation.Routing

<PageHeader Title="Verify Your Email" Subtitle="Enter the 6-digit code sent to your email address." />

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger py-2 small" role="alert">
        @ErrorMessage
    </div>
}

@if (!string.IsNullOrEmpty(SuccessMessage))
{
    <div class="alert alert-success py-2 small" role="alert">
        @SuccessMessage
    </div>
}

<EditForm Model="Model"
          FormName="verify-email-form"
          OnValidSubmit="HandleValidSubmit"
          Enhance
          novalidate>
    <DataAnnotationsValidator />

    <div class="mb-3 text-center">
        <label for="verificationCode" class="form-label fw-medium visually-hidden">6-Digit Verification Code</label>
        <InputText id="verificationCode"
                   class="form-control text-center fw-bold fs-4 verification-code"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   pattern="\d{6}"
                   maxlength="6"
                   placeholder="123456"
                   @bind-Value="Model.Code" />
        <ValidationMessage For="() => Model.Code" class="invalid-feedback d-block" />
    </div>

    <div class="d-grid">
        <button type="submit" class="btn btn-primary w-100" disabled="@IsSubmitting">
            Verify Email
        </button>
    </div>
</EditForm>

<div class="d-flex flex-column align-items-center gap-2 mt-3 pt-3 border-top">
    @if (ResendCooldownSeconds > 0)
    {
        <p class="text-body-secondary small mb-0">
            You can request a new code in @ResendCooldownSeconds seconds.
        </p>
    }
    else
    {
        <form method="post" action="@AppRoutes.VerifyEmail?action=resend" class="d-inline">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-link text-decoration-none p-0 small" disabled="@IsSubmitting">
                Resend verification code
            </button>
        </form>
    }

    <form method="post" action="@AppRoutes.Logout" class="d-inline mt-1">
        <AntiforgeryToken />
        <button type="submit" class="btn btn-link text-decoration-none text-body-secondary small p-0">
            Log out and verify later
        </button>
    </form>
</div>

@code {
    [Parameter, EditorRequired] public EventCallback<VerifyEmailInput> OnSubmit { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? SuccessMessage { get; set; }
    [Parameter] public int ResendCooldownSeconds { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }

    [SupplyParameterFromForm]
    public VerifyEmailInput Model { get; set; } = default!;

    protected override void OnInitialized()
    {
        Model ??= new();
    }

    protected override void OnParametersSet()
    {
        Model ??= new();
    }

    private async Task HandleValidSubmit()
    {
        await OnSubmit.InvokeAsync(Model);
    }
}
