@using LearnQ.Application.Common.Models
@using LearnQ.Presentation.Routing

<div class="text-center mb-4">
    <h2 class="fw-bold">Sign In</h2>
    <p class="text-muted">Welcome back to LearnQ</p>
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @ErrorMessage
    </div>
}

<EditForm Model="Model"
          FormName="login-form"
          OnValidSubmit="HandleValidSubmit"
          Enhance
          novalidate>
    <DataAnnotationsValidator />

    <FormField Label="Email or Username"
               For="() => Model.Identifier"
               HelpText="Enter the email address or username for your account.">
        <InputText id="Identifier"
                   class="form-control"
                   autocomplete="username"
                   @bind-Value="Model.Identifier" />
    </FormField>

    <FormField Label="Password"
               For="() => Model.Password">
        <InputText id="Password"
                   type="password"
                   class="form-control"
                   autocomplete="current-password"
                   @bind-Value="Model.Password" />
    </FormField>

    <FormCheck For="() => Model.RememberMe">
        <Label>Remember me for 30 days</Label>
        <ChildContent>
            <InputCheckbox id="RememberMe"
                           class="form-check-input"
                           @bind-Value="Model.RememberMe" />
        </ChildContent>
    </FormCheck>

    @* TODO: Add forgot password flow and link once password recovery endpoints are implemented in backend. *@

    <div class="d-grid gap-2">
        <button type="submit" class="btn btn-primary btn-lg" disabled="@IsSubmitting">
            <span>Sign In</span>
        </button>
    </div>

    <div class="text-center mt-4">
        <p class="text-muted small mb-0">
            Don't have an account?
            <a href="@AppRoutes.Register" class="text-decoration-none fw-semibold">Register here</a>
        </p>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public EventCallback<LoginInput> OnSubmit { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }

    [SupplyParameterFromForm]
    public LoginInput Model { get; set; } = default!;

    protected override void OnInitialized()
    {
        Model ??= new();
    }

    protected override void OnParametersSet()
    {
        Model ??= new();
    }

    private async Task HandleValidSubmit()
    {
        await OnSubmit.InvokeAsync(Model);
    }
}
