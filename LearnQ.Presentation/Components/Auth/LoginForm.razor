<PageHeader Title="Sign In" Subtitle="Welcome back to LearnQ" />

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger py-2 small" role="alert">
        @ErrorMessage
    </div>
}

<EditForm Model="Model"
          FormName="login-form"
          OnValidSubmit="HandleValidSubmit"
          Enhance
          novalidate>
    <DataAnnotationsValidator />

    <FormField Label="Identifier"
               For="() => Model.Identifier">
        <InputText id="Identifier"
                   class="form-control"
                   autocomplete="username"
                   @bind-Value="Model.Identifier" />
    </FormField>

    <FormField Label="Password"
               For="() => Model.Password">
        <InputText id="Password"
                   type="password"
                   class="form-control"
                   autocomplete="current-password"
                   @bind-Value="Model.Password" />
    </FormField>

    <FormCheck For="() => Model.RememberMe">
        <Label>Remember me for 30 days</Label>
        <ChildContent>
            <InputCheckbox id="RememberMe"
                           class="form-check-input"
                           @bind-Value="Model.RememberMe" />
        </ChildContent>
    </FormCheck>

    @* TODO: Add forgot password flow and link once password recovery endpoints are implemented in backend. *@

    <div class="d-grid mt-3">
        <button type="submit" class="btn btn-primary w-100" disabled="@IsSubmitting">
            Sign In
        </button>
    </div>
</EditForm>

<p class="text-center text-body-secondary mt-3 mb-0">
    Don't have an account? <a href="@AppRoutes.Register">Register here</a>
</p>

@code {
    [Parameter, EditorRequired] public EventCallback<LoginInput> OnSubmit { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool IsSubmitting { get; set; }

    [SupplyParameterFromForm]
    public LoginInput Model { get; set; } = default!;

    protected override void OnInitialized()
    {
        Model ??= new();
    }

    protected override void OnParametersSet()
    {
        Model ??= new();
    }

    private async Task HandleValidSubmit()
    {
        await OnSubmit.InvokeAsync(Model);
    }
}
