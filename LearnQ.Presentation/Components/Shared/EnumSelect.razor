@typeparam TEnum where TEnum : struct, Enum

<select id="@Id" class="@Class" value="@Value.ToString()" @onchange="HandleChange" disabled="@Disabled">
    @foreach (var (key, label) in Labels)
    {
        <option value="@key.ToString()">@label</option>
    }
</select>

@code {
    [Parameter, EditorRequired] public TEnum Value { get; set; }
    [Parameter] public EventCallback<TEnum> ValueChanged { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<TEnum>>? ValueExpression { get; set; }
    [Parameter, EditorRequired] public IReadOnlyDictionary<TEnum, string> Labels { get; set; } = default!;
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Class { get; set; } = "form-select";
    [Parameter] public bool Disabled { get; set; }

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<TEnum>(e.Value?.ToString(), out var result))
        {
            Value = result;
            await ValueChanged.InvokeAsync(result);
        }
    }
}
